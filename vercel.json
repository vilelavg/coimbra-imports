{
  "rewrites": [
    {
      "source": "/(retro|feminino|infantil|modeloJogador|timesEuropeus|camisasCoimbra|selecoes|calcoes|conjuntos)/:path*",
      "destination": "/$1/:path*"
    },
    {
      "source": "/((?!static|_next|favicon.ico|logo.png|backRetro.png|manifest.json|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}